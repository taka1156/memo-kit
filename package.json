{
  "name": "memo-site-js-tests",
  "private": true,
  "description": "仕組みのページの JS（src/assets/memo-site.js・memo-quiz.js）のテストと、一覧の本文検索の索引（Pagefind）を作るためのもの。memo.py は標準ライブラリだけで動き、これには依存しない",
  "scripts": {
    "test": "vitest run",
    "search-index": "pagefind --site dist --exclude-selectors \"#memo-backlink\" --exclude-selectors \"#memo-quiz-ui\""
  },
  "dependencies": {
    "pagefind": "1.6.0"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "playwright": "1.65.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
